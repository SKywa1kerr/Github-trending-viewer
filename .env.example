GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=30
GITHUB_MAX_RETRIES=3
GITHUB_BACKOFF_SECONDS=1
API_ENDPOINT=https://models.sjtu.edu.cn/api/v1/chat/completions
API_KEY=
# SJTU gateway alias for the current Qwen deployment (qwen3.8-27b). Use the alias, not the
# versioned name: the versioned deployment is often in cooldown and returns 429.
API_MODEL=qwen
# Send response_format=json_object for translation/recommendation calls (auto-falls back if rejected).
AI_JSON_MODE=1
# Verify API_MODEL exists on the endpoint's /models list during health checks.
AI_MODEL_CHECK=1
TRANSLATION_CONCURRENCY=2
TRANSLATION_BATCH_SIZE=8
TRANSLATION_README_CHARS=1600
TRANSLATION_MAX_OUTPUT_TOKENS=700
TRANSLATION_REQUEST_INTERVAL_SECONDS=6.0
MAX_REQUESTS_PER_MINUTE=10
MAX_DAILY_TOKENS=1000000
UPDATE_HOUR=8
DATA_STALE_HOURS=72
APP_HOST_PORT=8098

# Docker container -> Windows host proxy.
# If you run the Python app outside Docker, use http://127.0.0.1:7897 instead.
APP_HTTP_PROXY=http://host.docker.internal:7897
APP_HTTPS_PROXY=http://host.docker.internal:7897
APP_NO_PROXY=localhost,127.0.0.1
